.DS_Store
.netlify/
# Clés de compte de service Firebase (ne jamais commiter)
*service-account*.json
*serviceAccount*.json
*firebase-admin-key*.json
*.credentials.json
scripts/node_modules/
# Identifiants OAuth Google / tokens (outils SEO, ne jamais commiter)
client_secret*.json
*seo-client*.json
token.json
token*.json
*.token
# Environnements virtuels Python
.venv/

# Generated by non-production builds only (see netlify.toml)
/public/_headers

# Rapports SEO internes : ils vivent dans ~/cocon-growth/reviews, jamais dans le site
reviews/
