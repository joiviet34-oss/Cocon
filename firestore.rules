rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── FEEDBACK ──────────────────────────────────────────
    // Création autorisée seulement pour l'utilisateur connecté,
    // et uniquement avec son propre uid.
    // Lecture, modification et suppression interdites côté client.
    match /feedback/{docId} {
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ─── USERS ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // ─── PROJECTS (+ sous-collections) ─────────────────────
    match /projects/{projectId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();

      match /{subcollection}/{docId} {
        allow read, create, update, delete: if isAuth();
      }
    }

    // ─── ANALYTICS ─────────────────────────────────────────
    match /affiliate_clicks/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
